# Copy this file to .env for local runs. Never commit .env.
# Nothing here is needed for the scripted model path, which is the default.

# Model path for the notebook and scripts: scripted | endpoint | colab
WORKSHOP_MODEL_PATH=scripted

# Only for WORKSHOP_MODEL_PATH=endpoint: any OpenAI-compatible endpoint.
# Examples: https://api.openai.com/v1, or http://localhost:11434/v1 for a local Ollama server.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
WORKSHOP_MODEL=replace-with-a-model-name
